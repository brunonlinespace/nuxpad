/*
 * Nuxpad Chicago95 Dark Qt adaptation
 * Geometry/interaction model: Nuxpad's Chicago95 light adaptation.
 * Dark palette authority: attached Gtk-Theme-Raleigh Raleigh-Dark.
 * Raleigh values: #434444 light base, #232424 base, #111111 dark base,
 * #000000 deepest edge, #ffffff foreground, #49667f selection.
 */

QWidget {
    background-color: #232424;
    color: #ffffff;
    selection-background-color: #49667f;
    selection-color: #ffffff;
}

QMainWindow, QDialog, QMessageBox { background-color: #232424; }

QMenuBar {
    background-color: #232424;
    color: #ffffff;
    border: 0px;
    spacing: 0px;
}
QMenuBar::item { background: transparent; padding: 3px 7px; }
QMenuBar::item:selected, QMenuBar::item:pressed {
    background-color: #49667f;
    color: #ffffff;
}
QMenu {
    background-color: #232424;
    color: #ffffff;
    border-top: 2px solid #434444;
    border-left: 2px solid #434444;
    border-right: 2px solid #000000;
    border-bottom: 2px solid #000000;
    padding: 2px;
}
QMenu::item { background: transparent; padding: 3px 24px 3px 20px; min-height: 16px; }
QMenu::item:selected { background-color: #49667f; color: #ffffff; }
QMenu::item:disabled { color: #999999; }
QMenu::separator {
    height: 2px; margin: 3px 2px; background: #111111;
    border-bottom: 1px solid #434444;
}
QMenu::indicator { width: 16px; height: 16px; }
QMenu::indicator:non-exclusive:checked {
    image: url("__CHICAGO95_ROOT__/original/gtk-3.0/assets/checkbox-checked.png");
}
QMenu::indicator:exclusive:unchecked {
    image: url("__CHICAGO95_ROOT__/original/gtk-3.0/assets/radio-unselected.png");
}
QMenu::indicator:exclusive:checked {
    image: url("__CHICAGO95_ROOT__/original/gtk-3.0/assets/radio-selected.png");
}
QMenu::indicator:exclusive:unchecked:disabled {
    image: url("__CHICAGO95_ROOT__/original/gtk-3.0/assets/radio-unselected-insensitive.png");
}
QMenu::indicator:exclusive:checked:disabled {
    image: url("__CHICAGO95_ROOT__/original/gtk-3.0/assets/radio-selected-insensitive.png");
}
QMenu::right-arrow {
    image: url("__CHICAGO95_ROOT__/original/gtk-3.0/assets/arrow-right.png");
    width: 10px; height: 10px;
}
QMenu::right-arrow:selected {
    image: url("__CHICAGO95_ROOT__/original/gtk-3.0/assets/arrow-right-selected.png");
}
QMenu::right-arrow {
    image: url("__RALEIGH_ROOT__/gtk-assets/dark/arrows/arrow-right.png");
    width: 10px; height: 10px;
}

QPushButton, QToolButton {
    background-color: #232424;
    color: #ffffff;
    border-top: 2px solid #434444;
    border-left: 2px solid #434444;
    border-right: 2px solid #000000;
    border-bottom: 2px solid #000000;
    border-radius: 0px;
    padding: 3px 7px;
    min-height: 18px;
}
QPushButton:hover, QToolButton:hover { background-color: #333333; }
QPushButton:pressed, QToolButton:pressed,
QPushButton:checked, QToolButton:checked {
    background-color: #111111;
    border-top: 2px solid #000000;
    border-left: 2px solid #000000;
    border-right: 2px solid #434444;
    border-bottom: 2px solid #434444;
    padding-left: 8px;
    padding-top: 4px;
}
QPushButton:focus, QToolButton:focus { outline: 1px dotted #ffffff; }
QPushButton:disabled, QToolButton:disabled { color: #999999; }
QToolButton::menu-indicator { image: none; width: 0px; }

QLineEdit, QTextEdit, QPlainTextEdit, QAbstractItemView {
    background-color: #434444;
    color: #ffffff;
    border-top: 2px solid #111111;
    border-left: 2px solid #111111;
    border-right: 2px solid #434444;
    border-bottom: 2px solid #434444;
    border-radius: 0px;
    selection-background-color: #49667f;
    selection-color: #ffffff;
}
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #333333;
    color: #999999;
}
QAbstractItemView::item:selected { background-color: #49667f; color: #ffffff; }

QComboBox {
    background-color: #434444;
    color: #ffffff;
    border-top: 2px solid #111111;
    border-left: 2px solid #111111;
    border-right: 2px solid #434444;
    border-bottom: 2px solid #434444;
    border-radius: 0px;
    padding: 2px 22px 2px 4px;
    min-height: 18px;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 18px;
    background: #232424;
    border-left: 1px solid #111111;
    border-top: 1px solid #434444;
    border-right: 1px solid #000000;
    border-bottom: 1px solid #000000;
}
QComboBox::down-arrow {
    image: url("__RALEIGH_ROOT__/gtk-assets/dark/arrows/arrow-down.png");
    width: 9px; height: 9px;
}
QComboBox::down-arrow:disabled {
    image: url("__RALEIGH_ROOT__/gtk-assets/dark/arrows/arrow-down-disabled.png");
}

QCheckBox, QRadioButton { spacing: 4px; background: transparent; }
QCheckBox::indicator { width: 16px; height: 16px; }
QCheckBox::indicator:unchecked {
    image: url("__CHICAGO95_ROOT__/original/gtk-3.0/assets/checkbox-unchecked.png");
}
QCheckBox::indicator:checked {
    image: url("__CHICAGO95_ROOT__/original/gtk-3.0/assets/checkbox-checked.png");
}
QCheckBox::indicator:unchecked:disabled {
    image: url("__CHICAGO95_ROOT__/original/gtk-3.0/assets/checkbox-unchecked-insensitive.png");
}
QCheckBox::indicator:checked:disabled {
    image: url("__CHICAGO95_ROOT__/original/gtk-3.0/assets/checkbox-checked-insensitive.png");
}
QRadioButton::indicator { width: 16px; height: 16px; }
QRadioButton::indicator:unchecked {
    image: url("__CHICAGO95_ROOT__/original/gtk-3.0/assets/radio-unselected.png");
}
QRadioButton::indicator:checked {
    image: url("__CHICAGO95_ROOT__/original/gtk-3.0/assets/radio-selected.png");
}
QRadioButton::indicator:unchecked:disabled {
    image: url("__CHICAGO95_ROOT__/original/gtk-3.0/assets/radio-unselected-insensitive.png");
}
QRadioButton::indicator:checked:disabled {
    image: url("__CHICAGO95_ROOT__/original/gtk-3.0/assets/radio-selected-insensitive.png");
}

QGroupBox {
    border-top: 1px solid #111111;
    border-left: 1px solid #111111;
    border-right: 1px solid #434444;
    border-bottom: 1px solid #434444;
    border-radius: 0px;
    margin-top: 9px;
    padding-top: 6px;
}
QGroupBox::title {
    subcontrol-origin: margin; subcontrol-position: top left; left: 8px;
    padding: 0px 3px; background-color: #232424; color: #ffffff;
}

QStatusBar { background-color: #232424; color: #ffffff; border-top: 1px solid #111111; }
QStatusBar::item { border: 0px; }
QStatusBar QLabel {
    background-color: #232424; color: #ffffff;
    border-top: 1px solid #111111; border-left: 1px solid #111111;
    border-right: 1px solid #434444; border-bottom: 1px solid #434444;
    padding: 1px 3px;
}

QScrollBar:vertical {
    background: #111111; width: 16px; margin: 16px 0px 16px 0px; border: 0px;
}
QScrollBar::handle:vertical {
    min-height: 18px; background: #232424;
    border-top: 2px solid #434444; border-left: 2px solid #434444;
    border-right: 2px solid #000000; border-bottom: 2px solid #000000;
}
QScrollBar::sub-line:vertical {
    subcontrol-origin: margin; subcontrol-position: top; height: 16px; background: #232424;
    image: url("__RALEIGH_ROOT__/gtk-assets/dark/arrows/arrow-up.png");
}
QScrollBar::add-line:vertical {
    subcontrol-origin: margin; subcontrol-position: bottom; height: 16px; background: #232424;
    image: url("__RALEIGH_ROOT__/gtk-assets/dark/arrows/arrow-down.png");
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: #111111; }

QScrollBar:horizontal {
    background: #111111; height: 16px; margin: 0px 16px 0px 16px; border: 0px;
}
QScrollBar::handle:horizontal {
    min-width: 18px; background: #232424;
    border-top: 2px solid #434444; border-left: 2px solid #434444;
    border-right: 2px solid #000000; border-bottom: 2px solid #000000;
}
QScrollBar::sub-line:horizontal {
    subcontrol-origin: margin; subcontrol-position: left; width: 16px; background: #232424;
    image: url("__RALEIGH_ROOT__/gtk-assets/dark/arrows/arrow-left.png");
}
QScrollBar::add-line:horizontal {
    subcontrol-origin: margin; subcontrol-position: right; width: 16px; background: #232424;
    image: url("__RALEIGH_ROOT__/gtk-assets/dark/arrows/arrow-right.png");
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: #111111; }

QToolTip {
    background-color: #12110d; color: #ffffff;
    border: 1px solid #000000; border-radius: 0px; padding: 2px;
}
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #111111; }
QDialogButtonBox QPushButton { min-width: 70px; }
#searchContainer, #bottomSearch { background-color: #232424; }
#editor {
    background-color: #434444;
    color: #ffffff;
    selection-background-color: #49667f;
    selection-color: #ffffff;
}
