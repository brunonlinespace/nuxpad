/*
 * Nuxpad 2.1.3-x2.3 — Kernel Modules light application shell.
 * Authority: LinSpectacles Kernel Modules 1.0.5-exp1.
 * No application font declaration. Document canvas is not shell-themed.
 */
QMainWindow, QDialog { background-color: #d4d4d4; }
QLabel { background-color: transparent; color: #202020; }

QMenuBar { background-color: #d4d4d4; color: #202020; spacing: 3px; }
QMenuBar::item { background-color: transparent; padding: 5px 8px; border: 1px solid transparent; border-radius: 3px; }
QMenuBar::item:selected { background-color: #dcecf8; color: #202020; }
QMenuBar::item:pressed { background-color: #0b64a0; color: #ffffff; }

QMenu { background-color: #f4f4f4; color: #202020; border: 1px solid #b2b2b2; padding: 3px; }
QMenu::item { background-color: transparent; color: #202020; padding: 5px 28px 5px 12px; border-radius: 3px; }
QMenu::item:selected { background-color: #0b64a0; color: #ffffff; }
QMenu::item:disabled { color: #999999; }
QMenu::separator { height: 1px; background-color: #b2b2b2; margin: 4px 7px; }

QPushButton, QToolButton {
    background-color: #e4e4e4; color: #202020;
    border: 1px solid #b2b2b2; border-radius: 3px; padding: 4px 8px;
}
QPushButton:hover, QToolButton:hover { background-color: #dcecf8; border-color: #0b64a0; color: #202020; }
QPushButton:pressed, QToolButton:pressed, QToolButton:checked {
    background-color: #c5e0f2; border-color: #0b64a0; color: #202020;
}
QPushButton:disabled, QToolButton:disabled { background-color: #d0d0d0; color: #999999; border-color: #cccccc; }
QToolButton::menu-indicator { image: none; width: 0px; }

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #f4f4f4; color: #202020;
    border: 1px solid #b2b2b2; border-radius: 4px; padding: 4px 8px;
    selection-background-color: #0b64a0; selection-color: #ffffff;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border: 1px solid #0b64a0; }
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background-color: #d0d0d0; color: #999999; border-color: #cccccc;
}
QComboBox::drop-down { border: 0; width: 22px; }
QComboBox QAbstractItemView {
    background-color: #f4f4f4; color: #202020; border: 1px solid #b2b2b2;
    selection-background-color: #0b64a0; selection-color: #ffffff; outline: 0;
}

QTextEdit {
    background-color: #f4f4f4; color: #202020; border: 1px solid #b2b2b2;
    selection-background-color: #0b64a0; selection-color: #ffffff;
}
QGroupBox {
    border: 1px solid #b2b2b2; border-radius: 6px; margin-top: 6px;
    padding-top: 10px; background-color: #e4e4e4; color: #202020;
}
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; color: #202020; }
QCheckBox, QRadioButton { background-color: transparent; color: #202020; spacing: 6px; }
QCheckBox:disabled, QRadioButton:disabled { color: #999999; }

QAbstractItemView {
    background-color: #f4f4f4; alternate-background-color: #e4e4e4; color: #202020;
    border: 1px solid #b2b2b2; selection-background-color: #0b64a0;
    selection-color: #ffffff; outline: 0;
}
QHeaderView::section { background-color: #e4e4e4; color: #202020; padding: 5px; border: 1px solid #b2b2b2; }

QTabWidget::pane { border: 1px solid #b2b2b2; background-color: #d4d4d4; }
QTabBar::tab {
    background-color: #e4e4e4; color: #4a4a4a; padding: 8px 16px;
    border: 1px solid #b2b2b2; border-bottom: none;
    border-top-left-radius: 4px; border-top-right-radius: 4px; margin-right: 2px;
}
QTabBar::tab:selected { background-color: #0b64a0; color: #ffffff; }
QTabBar::tab:hover:!selected { background-color: #dcecf8; color: #202020; }

QStatusBar { background-color: #d4d4d4; color: #303030; border-top: 1px solid #b2b2b2; }
QStatusBar QLabel { color: #303030; }
QStatusBar::item { border: none; }

QScrollBar:vertical, QScrollBar:horizontal { background: #d4d4d4; border: none; width: 10px; height: 10px; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background: #b0b0b0; border-radius: 5px; }
QScrollBar::handle:vertical { min-height: 24px; }
QScrollBar::handle:horizontal { min-width: 24px; }
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background: #8e8e8e; }
QScrollBar::add-line, QScrollBar::sub-line { background: #e4e4e4; border: none; width: 0px; height: 0px; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QToolTip { background-color: #f4f4f4; color: #202020; border: 1px solid #b2b2b2; padding: 4px; }
