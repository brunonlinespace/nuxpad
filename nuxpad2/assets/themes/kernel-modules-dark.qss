/*
 * Nuxpad 2.1.3-x2.0 — Kernel Modules dark-theme experiment.
 * Visual authority: LinSpectacles Kernel Modules 1.0.7 standalone stylesheet.
 * No application typeface or point-size declaration is included.
 */

QMainWindow, QDialog, QWidget {
    background-color: #1e1e1e;
    color: #dcdcdc;
}
QLabel {
    background-color: transparent;
    color: #dcdcdc;
}
QMenuBar {
    background-color: #1e1e1e;
    color: #dcdcdc;
    spacing: 3px;
}
QMenuBar::item {
    background-color: transparent;
    padding: 5px 8px;
    border: 1px solid transparent;
    border-radius: 3px;
}
QMenuBar::item:selected {
    background-color: #3e3e42;
    color: #ffffff;
}
QMenuBar::item:pressed {
    background-color: #007acc;
    color: #ffffff;
}
QMenu {
    background-color: #252526;
    color: #dcdcdc;
    border: 1px solid #333333;
    padding: 3px;
}
QMenu::item {
    background-color: transparent;
    color: #dcdcdc;
    padding: 5px 28px 5px 12px;
    border-radius: 3px;
}
QMenu::item:selected {
    background-color: #007acc;
    color: #ffffff;
}
QMenu::item:disabled {
    color: #686868;
}
QMenu::separator {
    height: 1px;
    background-color: #333333;
    margin: 4px 7px;
}
QPushButton, QToolButton {
    background-color: #333333;
    color: #ffffff;
    border: 1px solid #454545;
    border-radius: 3px;
    padding: 4px 8px;
}
QPushButton:hover, QToolButton:hover {
    background-color: #007acc;
    border-color: #007acc;
    color: #ffffff;
}
QPushButton:pressed, QToolButton:pressed, QToolButton:checked {
    background-color: #005999;
    border-color: #005999;
    color: #ffffff;
}
QPushButton:disabled, QToolButton:disabled {
    background-color: #252526;
    color: #686868;
    border-color: #333333;
}
QToolButton::menu-indicator {
    image: none;
    width: 0px;
}
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #333333;
    color: #ffffff;
    border: 1px solid #454545;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #007acc;
    selection-color: #ffffff;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #007acc;
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background-color: #252526;
    color: #686868;
    border-color: #333333;
}
QComboBox::drop-down {
    border: 0;
    width: 22px;
}
QComboBox QAbstractItemView {
    background-color: #252526;
    color: #dcdcdc;
    border: 1px solid #333333;
    selection-background-color: #094771;
    selection-color: #ffffff;
    outline: 0;
}
QTextEdit {
    background-color: #1e1e1e;
    color: #dcdcdc;
    border: 1px solid #333333;
    border-radius: 4px;
    selection-background-color: #094771;
    selection-color: #ffffff;
}
QTextEdit:focus {
    border: 1px solid #333333;
}
QGroupBox {
    border: 1px solid #333333;
    border-radius: 6px;
    margin-top: 6px;
    padding-top: 10px;
    background-color: #252526;
    color: #dcdcdc;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: #dcdcdc;
}
QCheckBox, QRadioButton {
    background-color: transparent;
    color: #dcdcdc;
    spacing: 6px;
}
QCheckBox:disabled, QRadioButton:disabled {
    color: #686868;
}
QAbstractItemView {
    background-color: #1e1e1e;
    alternate-background-color: #252526;
    color: #dcdcdc;
    border: 1px solid #333333;
    selection-background-color: #094771;
    selection-color: #ffffff;
    outline: 0;
}
QHeaderView::section {
    background-color: #2d2d2d;
    color: #ffffff;
    padding: 5px;
    border: 1px solid #333333;
}
QTabWidget::pane {
    border: 1px solid #333333;
    background-color: #1e1e1e;
}
QTabBar::tab {
    background-color: #2d2d2d;
    color: #aaaaaa;
    padding: 8px 16px;
    border: 1px solid #333333;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #007acc;
    color: #ffffff;
}
QTabBar::tab:hover:!selected {
    background-color: #3e3e42;
    color: #ffffff;
}
QStatusBar {
    background-color: #252526;
    color: #dcdcdc;
    border-top: 1px solid #333333;
}
QStatusBar::item {
    border: none;
}
QScrollBar:vertical, QScrollBar:horizontal {
    background: #1e1e1e;
    border: none;
    width: 10px;
    height: 10px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #424242;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    min-height: 24px;
}
QScrollBar::handle:horizontal {
    min-width: 24px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #686868;
}
QScrollBar::add-line, QScrollBar::sub-line {
    background: #2d2d2d;
    border: none;
    width: 0px;
    height: 0px;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}
QToolTip {
    background-color: #2d2d2d;
    color: #ffffff;
    border: 1px solid #454545;
    padding: 4px;
}

/*
 * Keyboard Shortcuts dialog authority:
 * LinSpectacles Kernel Modules 1.0.5-exp1 DARK_STYLESHEET.
 * Font face intentionally remains Nuxpad/host-controlled.
 */
QDialog#keyboardShortcutsDialog {
    background-color: #1e1e1e;
    color: #dcdcdc;
    font-size: 10pt;
}
QDialog#keyboardShortcutsDialog QLineEdit,
QDialog#keyboardShortcutsDialog QComboBox {
    background-color: #333333;
    color: #ffffff;
    border: 1px solid #454545;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #007acc;
}
QDialog#keyboardShortcutsDialog QLineEdit:focus,
QDialog#keyboardShortcutsDialog QComboBox:focus {
    border: 1px solid #007acc;
}
QComboBox#keyboardShortcutsMenu QAbstractItemView {
    background-color: #252526;
    color: #dcdcdc;
    selection-background-color: #094771;
    selection-color: #ffffff;
}
QDialog#keyboardShortcutsDialog QTableWidget {
    background-color: #1e1e1e;
    alternate-background-color: #252526;
    color: #dcdcdc;
    gridline-color: #2d2d2d;
    border: 1px solid #333333;
    border-radius: 4px;
}
QDialog#keyboardShortcutsDialog QTableWidget::item:selected {
    background-color: #094771;
    color: #ffffff;
}
QDialog#keyboardShortcutsDialog QHeaderView::section {
    background-color: #2d2d2d;
    color: #ffffff;
    padding: 5px;
    border: 1px solid #333333;
    font-weight: bold;
}
QDialog#keyboardShortcutsDialog QPushButton {
    background-color: #333333;
    color: #ffffff;
    border: 1px solid #454545;
    border-radius: 3px;
    padding: 4px 8px;
}
QDialog#keyboardShortcutsDialog QPushButton:hover {
    background-color: #007acc;
    border-color: #007acc;
}
QDialog#keyboardShortcutsDialog QPushButton:pressed {
    background-color: #005999;
    border-color: #454545;
}
QDialog#keyboardShortcutsDialog QPushButton:disabled {
    background-color: #2a2a2a;
    color: #777777;
    border-color: #3a3a3a;
}
QDialog#keyboardShortcutsDialog QScrollBar:vertical,
QDialog#keyboardShortcutsDialog QScrollBar:horizontal {
    background: #1e1e1e;
    border: none;
    width: 10px;
    height: 10px;
}
QDialog#keyboardShortcutsDialog QScrollBar::handle:vertical,
QDialog#keyboardShortcutsDialog QScrollBar::handle:horizontal {
    background: #424242;
    border-radius: 5px;
}
QDialog#keyboardShortcutsDialog QScrollBar::handle:vertical:hover,
QDialog#keyboardShortcutsDialog QScrollBar::handle:horizontal:hover {
    background: #686868;
}

