QPlainTextEdit {
    background-color: #80ffff;
    color: #000080;
    border: 1px solid #b8b8b8;
    border-radius: 4px;
    selection-background-color: #0b64a0;
    selection-color: #ffffff;
}
QPlainTextEdit:focus { border: 1px solid #b8b8b8; }
QScrollBar:vertical,
QScrollBar:horizontal {
    background: #f3f3f3;
    border: none;
    width: 10px;
    height: 10px;
}
QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: #b0b0b0;
    border-radius: 5px;
}
QScrollBar::handle:vertical { min-height: 24px; }
QScrollBar::handle:horizontal { min-width: 24px; }
QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover { background: #8e8e8e; }
QScrollBar::add-line,
QScrollBar::sub-line {
    background: #e6e6e6;
    border: none;
    width: 0px;
    height: 0px;
}
QScrollBar::add-page,
QScrollBar::sub-page { background: transparent; }
